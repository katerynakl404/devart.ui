{
  "name": "@devart/ui-react",
  "version": "1.0.0",
  "description": "Devart.UI.React - design-system package: Radix-based UI primitives, CVA variants, and Tailwind theme tokens.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://git.devart.com/devart/components/devart.ui.react.git"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "globals.css",
    "fonts.css",
    "fonts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');for (const p of ['dist','.tsbuildinfo']) fs.rmSync(p,{recursive:true,force:true});\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/verify-dist.mjs",
    "bundle": "node scripts/bundle.mjs",
    "check-bundle-css": "node scripts/check-bundle-css.mjs",
    "clean": "node -e \"const fs=require('node:fs');for (const p of ['dist','.tsbuildinfo','.turbo','coverage','node_modules']){try{fs.rmSync(p,{recursive:true,force:true});}catch{}}\"",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "changeset": "changeset",
    "check-changeset": "node scripts/check-changeset.mjs",
    "smoke": "node scripts/smoke/verify-consumer.mjs",
    "version-packages": "changeset version",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "exports": {
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./globals.css": "./globals.css",
    "./fonts.css": "./fonts.css",
    "./package.json": "./package.json",
    "./cn": {
      "source": "./src/lib/utils.ts",
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./use-mobile": {
      "source": "./src/hooks/use-mobile.tsx",
      "types": "./dist/hooks/use-mobile.d.ts",
      "default": "./dist/hooks/use-mobile.js"
    },
    "./*": {
      "source": "./src/components/*/index.tsx",
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./portal-container": {
      "source": "./src/lib/portal-container.ts",
      "types": "./dist/lib/portal-container.d.ts",
      "default": "./dist/lib/portal-container.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://dbfnexus.devart.com/repository/PENDING-DEVOPS/",
    "exports": {
      "./tailwind-preset": {
        "types": "./dist/tailwind-preset.d.ts",
        "default": "./dist/tailwind-preset.js"
      },
      "./globals.css": "./globals.css",
      "./fonts.css": "./fonts.css",
      "./package.json": "./package.json",
      "./cn": {
        "types": "./dist/lib/utils.d.ts",
        "default": "./dist/lib/utils.js"
      },
      "./use-mobile": {
        "types": "./dist/hooks/use-mobile.d.ts",
        "default": "./dist/hooks/use-mobile.js"
      },
      "./*": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.js"
      },
      "./portal-container": {
        "types": "./dist/lib/portal-container.d.ts",
        "default": "./dist/lib/portal-container.js"
      }
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@changesets/cli": "^2.29.7",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.23",
    "jsdom": "^26.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "storybook": "^10.4.6",
    "tailwindcss": "^3.4.7",
    "tsc-alias": "^1.9.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react-day-picker": "^9.13.0",
    "react-resizable-panels": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "@types/react": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^3.4"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.27.0"
}
