{
  "projectId": "ff886db2-b664-4103-8ea6-def41cba21d8",
  "shape": "storybook",
  "pkg": "@devart/ui-react",
  "globalName": "DevartUI",
  "storybookConfigDir": ".storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "buildCmd": "corepack pnpm run build && node .design-sync/make-entry.mjs && node .design-sync/gen-classlist.mjs && corepack pnpm exec tailwindcss -c .design-sync/tailwind-export.config.ts -i .design-sync/tailwind-export.css -o .design-sync/.cache/ds-utilities.css --minify",
  "entry": "./dist/_ds-entry.js",
  "tokensGlob": [
    "globals.css"
  ],
  "extraFonts": [
    "fonts.css"
  ],
  "storyImports": {
    "loaders": {
      ".woff2": "dataurl",
      ".woff": "dataurl",
      ".ttf": "dataurl"
    }
  },
  "titleMap": {
    "Datepicker": "SingleDatePicker",
    "Resizable": "ResizablePanelGroup",
    "Toast": "ToastMessage"
  },
  "cssEntry": ".design-sync/.cache/ds-utilities.css",
  "guidelinesGlob": [
    "SPEC.md",
    "README.md"
  ],
  "readmeHeader": ".design-sync/conventions.md",
  "provider": {
    "component": "TooltipProvider",
    "inner": {
      "component": "PortalContainerProvider"
    }
  },
  "overrides": {
    "DropdownMenu": {
      "cardMode": "single",
      "primaryStory": "ItemStates"
    },
    "Modal": {
      "cardMode": "single",
      "primaryStory": "Sizes",
      "viewport": "900x1050"
    },
    "Popover": {
      "cardMode": "single",
      "primaryStory": "InitiallyOpen"
    },
    "Sheet": {
      "cardMode": "single",
      "primaryStory": "InitiallyOpen"
    },
    "Sidebar": {
      "cardMode": "single",
      "primaryStory": "RowStates",
      "viewport": "900x2000"
    },
    "TextArea": {
      "cardMode": "column",
      "viewport": "900x2000"
    },
    "Timeline": {
      "cardMode": "column",
      "viewport": "900x2000"
    },
    "Card": {
      "cardMode": "column",
      "viewport": "900x2000"
    },
    "Collapsible": {
      "cardMode": "column",
      "viewport": "900x850"
    },
    "ToastMessage": {
      "cardMode": "column",
      "viewport": "900x2000"
    },
    "Autocomplete": {
      "cardMode": "single",
      "primaryStory": "MultipleSelectOpen"
    },
    "Tooltip": {
      "cardMode": "single",
      "primaryStory": "Widths"
    },
    "Colors": {
      "viewport": "900x1850"
    },
    "Typography": {
      "viewport": "900x2000"
    },
    "Banner": {
      "cardMode": "column",
      "viewport": "900x2000"
    },
    "Pagination": {
      "cardMode": "column",
      "viewport": "900x950"
    },
    "SingleDatePicker": {
      "cardMode": "column",
      "viewport": "900x2000"
    },
    "StepSlider": {
      "cardMode": "column",
      "viewport": "900x2000"
    },
    "Table": {
      "cardMode": "column",
      "viewport": "900x2000"
    },
    "Tabs": {
      "cardMode": "column",
      "viewport": "900x1250"
    },
    "StatusView": {
      "viewport": "900x2000"
    },
    "InputGroup": {
      "viewport": "900x2000"
    },
    "File": {
      "viewport": "900x2000"
    },
    "Button": {
      "viewport": "900x2000"
    },
    "PasswordInput": {
      "viewport": "900x1850"
    },
    "ToggleGroup": {
      "viewport": "900x1600"
    },
    "Toggle": {
      "viewport": "900x1350"
    },
    "Badge": {
      "viewport": "900x1250"
    },
    "Accordion": {
      "viewport": "900x1200"
    },
    "RadioButton": {
      "viewport": "900x1100"
    },
    "Skeleton": {
      "viewport": "900x1000"
    },
    "ProgressBar": {
      "viewport": "900x950"
    },
    "CircularProgress": {
      "viewport": "900x950"
    },
    "Switch": {
      "viewport": "900x900"
    },
    "ResizablePanelGroup": {
      "viewport": "900x850"
    },
    "ScrollShadow": {
      "viewport": "900x850"
    },
    "IconButton": {
      "viewport": "900x850"
    },
    "Input": {
      "viewport": "900x800"
    }
  }
}
